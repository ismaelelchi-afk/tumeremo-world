{
  "name": "tumeremo-world",
  "private": true,
  "version": "1.0.0",
  "description": "Mapa digital bilingüe de Tumeremo, Venezuela, con experiencias WORLD y STUDIO.",
  "type": "module",
  "keywords": [
    "tumeremo",
    "mapa",
    "openstreetmap",
    "maplibre",
    "threejs",
    "react",
    "typescript",
    "i18n"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "npm run build:public",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "build:public": "vite build --config vite.public.config.ts --mode public",
    "build:studio": "vite build --config vite.studio.config.ts --mode studio",
    "prepare:world": "node scripts/prepare-public-world.mjs",
    "verify:world": "node scripts/verify-world.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check:all": "npm run typecheck && npm run verify:world && npm run build:public && npm run build:studio && npm run verify:bundle -- dist-public && npm run verify:bundle -- dist-studio",
    "deploy:public": "node scripts/deploy-cloudflare.mjs public",
    "deploy:studio": "node scripts/deploy-cloudflare.mjs studio"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "maplibre-gl": "^5.24.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
